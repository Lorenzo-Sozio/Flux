{
  "$schema": "node_modules/wrangler/config-schema.json",

  // ⚠️ Deve coincidere con il nome del Worker su Cloudflare, e con il `service`
  // del binding WORKER_SELF_REFERENCE qui sotto. Se i tre nomi divergono il
  // deploy fallisce con:
  //   Service binding 'WORKER_SELF_REFERENCE' references Worker '…' which was not found.
  // Il nome NON viene dedotto da package.json ("studio-admin"): quello è il nome
  // del pacchetto npm, non del Worker.
  "name": "flux",

  // Entrypoint custom: riusa il fetch handler generato da OpenNext e vi aggiunge
  // l'handler `scheduled`, senza il quale i Cron Triggers non hanno dove atterrare.
  "main": "custom-worker.ts",

  // ⚠️ `wrangler deploy` NON basta da solo. Vedendo open-next.config.ts, wrangler
  // riconosce il progetto come OpenNext e ridirige a `opennextjs-cloudflare deploy`,
  // che pretende `.open-next/.build/open-next.config.edge.mjs`. Se prima non è girato
  // `opennextjs-cloudflare build` il deploy muore con un messaggio che sembra arrivare
  // dal nulla:
  //   ERROR Could not find compiled Open Next config, did you run the build command?
  // Su Cloudflare Workers Builds il build command deve essere
  // `npx opennextjs-cloudflare build`, non `npm run build`.
  // In locale: `npm run cf:deploy`, che fa entrambe le cose.

  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },

  "services": [
    {
      // Auto-riferimento: il Worker chiama sé stesso per la revalidation ISR.
      // `service` deve essere identico a `name`.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "flux"
    }
  ],

  "images": {
    "binding": "IMAGES"
  },

  /**
   * Dove vivono i documenti caricati.
   *
   * ⚠️ Senza questo binding gli allegati finiscono sul disco locale, che su Workers
   * non esiste e su Vercel non sopravvive al deploy successivo: il caricamento
   * riesce e il file sparisce, lasciando una riga che punta al nulla.
   *
   * Il bucket va creato una volta:
   *     npx wrangler r2 bucket create flux-documents
   */
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "flux-documents"
    }
  ],

  "observability": {
    "enabled": true
  },

  // ⚠️ `wrangler deploy` SOSTITUISCE le vars remote con queste: quello che è stato
  // aggiunto dalla dashboard e non è ripetuto qui viene CANCELLATO al deploy
  // successivo, senza chiedere niente in modalità non interattiva.
  // Quindi: ogni variabile non segreta va dichiarata qui, non nella dashboard.
  //
  // I segreti invece NON vanno qui (questo file è in git): si impostano con
  // `npx wrangler secret put NOME` e sopravvivono ai deploy, perché wrangler non
  // li gestisce dalla configurazione. Servono:
  //   DATABASE_URL  AUTH_SECRET  ADMIN_SESSION_SECRET
  //   PLATFORM_ENCRYPTION_KEY  IMPORT_API_KEY  CRON_SECRET
  /**
   * ⚠️⚠️ Senza questo, ogni deploy CANCELLA i segreti del Worker.
   *
   * Per wrangler questo file e la sola fonte di verita sulle variabili: al deploy
   * sostituisce l'elenco dei binding con quello che trova qui e rimuove tutto il
   * resto. I segreti impostati con `wrangler secret put` o dal pannello non
   * compaiono in nessun file di configurazione — e per come sono fatti non
   * possono — quindi sono esattamente cio che viene rimosso: DATABASE_URL,
   * AUTH_SECRET, PLATFORM_ENCRYPTION_KEY, CRON_SECRET, RESEND_API_KEY.
   *
   * Nel sorgente di wrangler la riga e `keepSecrets: keepVars || !!secretsFile`:
   * i segreti sopravvivono solo se sopravvivono le variabili.
   *
   * Il deploy riesce. E la richiesta successiva a fallire, e senza
   * PLATFORM_ENCRYPTION_KEY nessun database tenant puo essere decifrato, quindi
   * ogni pagina risponde con un errore mentre il deploy sembra andato a buon fine.
   *
   * Sta qui e non solo come flag `--keep-vars` sugli script perche vale per
   * QUALUNQUE deploy, compreso `npx wrangler deploy` digitato nella casella di
   * Workers Builds, dove nessuno script npm passa mai.
   */
  "keep_vars": true,

  "vars": {
    // Serve due volte: a build time (Next la inlinea nel bundle client) e a
    // runtime (custom-worker.ts la usa come base URL dei cron). Senza slash finale.
    "NEXT_PUBLIC_APP_URL": "https://flux.schedulatore.workers.dev",
    // Dominio nudo, senza schema né slash.
    "NEXT_PUBLIC_ROOT_DOMAIN": "flux.schedulatore.workers.dev"
  },

  // Sostituiscono i crons di vercel.json: su Cloudflare i job non sono richieste
  // HTTP schedulate dalla piattaforma, ma invocazioni dell'handler `scheduled`.
  // Chi mappa cron → path è custom-worker.ts: le due liste vanno tenute allineate.
  //
  // ⚠️ Il piano Free consente 5 Cron Trigger per account. I sette job dell'app sono
  // raggruppati in cinque schedule proprio per starci dentro; aggiungerne uno sesto
  // richiede Workers Paid.
  "triggers": {
    "crons": ["* * * * *", "*/5 * * * *", "*/15 * * * *", "0 6 * * *", "0 3 * * *"]
  }

  // Cache incrementale su R2 (ISR/data cache persistente fra le invocazioni).
  // Disattivata di default perché richiede un bucket già esistente, altrimenti il
  // deploy fallisce. Per abilitarla:
  //   1. npx wrangler r2 bucket create flux-opennext-cache
  //   2. togli il commento al blocco qui sotto
  //   3. togli il commento a `incrementalCache` in open-next.config.ts
  //
  // "r2_buckets": [
  //   {
  //     "binding": "NEXT_INC_CACHE_R2_BUCKET",
  //     "bucket_name": "flux-opennext-cache"
  //   }
  // ]
}
