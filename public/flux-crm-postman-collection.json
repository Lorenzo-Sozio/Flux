    {
      "name": "Webhooks",
      "description": "Inbound webhooks from Stripe and Resend",
      "item": [
        {
          "name": "Stripe webhook",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "stripe-signature",
                "value": "t=1715760000,v1=abc123...",
                "description": "Stripe HMAC signature header"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/stripe",
              "host": ["{{baseUrl}}"],
              "path": ["api", "webhooks", "stripe"]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Receives Stripe events and updates subscriptions in the database. Verifies HMAC signature via `STRIPE_WEBHOOK_SECRET`. Implements idempotency. Handles: `checkout.session.completed`, `customer.subscription.*`, `invoice.payment_succeeded`, `invoice.payment_failed`."
          }
        },
        {
          "name": "Resend email events webhook",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/resend",
              "host": ["{{baseUrl}}"],
              "path": ["api", "webhooks", "resend"]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Receives delivery events from Resend (`email.sent`, `email.delivered`, `email.bounced`, `email.complained`) and updates campaign logs."
          }
        },
        {
          "name": "Inbound email webhook",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/email-inbound",
              "host": ["{{baseUrl}}"],
              "path": ["api", "webhooks", "email-inbound"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from\": \"\",\n  \"to\": [],\n  \"subject\": \"\",\n  \"text\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Receives inbound emails forwarded by Resend. Identifies the ticket from the `To` field (e.g. `ticket-TKT0042@reply.flux.io`) and appends the content as a ticket comment."
          }
        }
      ]
    },
