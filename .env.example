# ── Database ──────────────────────────────────────────────────────────────────
# Platform database: tenant registry, user accounts, credentials, billing.
# Neon PostgreSQL (https://neon.tech) or any PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Encrypts each tenant's database connection string at rest (AES-256-GCM).
# ⚠️ NOT optional: without it decryptDbUrl() throws and the app cannot serve a
# single page. Losing it makes every tenant connection string unrecoverable.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLATFORM_ENCRYPTION_KEY=""

# ── Authentication ────────────────────────────────────────────────────────────
AUTH_SECRET="generate-with: openssl rand -base64 32"

# Signs the /admin panel session cookie, which is separate from the customer
# session on purpose. ⚠️ Without it the platform admin panel cannot be used.
# Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=""

# Google OAuth (optional)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Public address ────────────────────────────────────────────────────────────
# ⚠️ The single most consequential variable to get right, and the one that fails
# most quietly. Every outbound link is built from it: invitations, password
# resets, task reminders, campaign click tracking, the unsubscribe link and the
# public quote page. An unset value used to fall back to localhost, so the mail
# was delivered successfully and pointed at a machine the recipient cannot reach.
# In production the app now refuses to start rather than send those links.
# No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Read by NextAuth itself. Keep it equal to NEXT_PUBLIC_APP_URL.
NEXTAUTH_URL="http://localhost:3000"

# ── Email ─────────────────────────────────────────────────────────────────────
# A workspace can override all of this in Settings → Email; these values are the
# fallback used before any workspace has configured its own, and by the platform
# itself (invitations, admin OTP).
EMAIL_PROVIDER="resend"                      # "resend" | "smtp"

# Resend — sign up at https://resend.com, free tier 100 emails/day.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"

# SMTP — used when EMAIL_PROVIDER="smtp"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"                          # "true" for implicit TLS (port 465)

EMAIL_FROM_ADDRESS="noreply@yourdomain.com"
EMAIL_FROM_NAME="Flux CRM"
# Legacy combined form, still read by some helpers.
EMAIL_FROM="Flux CRM <noreply@yourdomain.com>"

# From address used by automation rules that send email.
AUTOMATION_FROM_EMAIL="automation@yourdomain.com"

# How many queued emails one email-worker run sends, per workspace.
EMAILS_PER_WORKER_RUN="30"

# Signs campaign open/click tracking URLs so a tracking link cannot be forged
# into an open redirect. ⚠️ Without it tracking links cannot be verified.
# Generate with: openssl rand -hex 32
TRACKING_SECRET=""

# Signs the calendar subscription URLs people paste into Google Calendar,
# Outlook or Apple Calendar. A calendar client cannot log in, so the address is
# the credential — whoever holds one can read that person's appointments.
# ⚠️ Rotating this withdraws every subscription at once, which is the only way
# to revoke a leaked address. It is separate from AUTH_SECRET precisely so that
# withdrawing them does not sign everybody out. Falls back to AUTH_SECRET when
# unset, which works but ties the two together.
# Generate with: openssl rand -hex 32
CALENDAR_FEED_SECRET=""

# Verifies delivery callbacks from Resend (bounces and spam complaints). Without
# it the callback is rejected and bounced addresses never reach the suppression
# list, so the same dead address is mailed again on the next campaign.
# Resend dashboard → Webhooks → Signing secret.
RESEND_WEBHOOK_SECRET=""

# Inbound email → ticket. Set one of these depending on the bridge you use.
# Generic bridge (Cloudmailin, Mailgun, SendGrid Inbound Parse): sent as the
# X-Webhook-Secret header.
INBOUND_EMAIL_SECRET=""
# Resend inbound webhook signing secret.
RESEND_INBOUND_WEBHOOK_SECRET=""
# Domain of the Bcc archive addresses (crm+<workspace>.<token>@<this>): each person
# puts theirs in Bcc from Gmail or Outlook and the email is filed on the records it
# was sent to. Its MX must deliver to one of the inbound webhooks above. Unset, the
# profile page says the archive is not available here.
INBOUND_BCC_DOMAIN=""

# Cloudflare Turnstile on the public contact and support forms (Settings → Forms).
# Optional: without them the forms rely on a hidden field and the rate limit.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# A person's own Gmail / Microsoft 365 mailbox and calendar (profile page). Dormant
# without these: the profile says the connection is not available here. With the
# credentials but no *_VERIFIED=1, only Flux staff can connect (test mode): set it once
# the provider has verified the app — Google's review of the restricted Gmail scopes,
# Microsoft's publisher verification. Redirect URI to register at the provider:
#   <NEXT_PUBLIC_APP_URL>/api/mail/callback/google   (and /microsoft)
# Separate from AUTH_GOOGLE_*: signing in needs no mailbox scopes, and should not wait
# for a mailbox review. On Cloudflare set the secrets with wrangler secret put.
MAIL_GOOGLE_CLIENT_ID=""
MAIL_GOOGLE_CLIENT_SECRET=""
MAIL_GOOGLE_VERIFIED=""
MAIL_MICROSOFT_CLIENT_ID=""
MAIL_MICROSOFT_CLIENT_SECRET=""
# Directory to sign in against: "common" (default) for any organisation.
MAIL_MICROSOFT_TENANT=""
MAIL_MICROSOFT_VERIFIED=""

# ── Document storage ──────────────────────────────────────────────────────────
# ⚠️ Uploaded files must not live on the local disk. On Cloudflare Workers there is
# none; on Vercel there is one, which is worse — the write succeeds and the file is
# gone by the next deploy, leaving a document row pointing at nothing.
#
# On Cloudflare the R2 binding in wrangler.jsonc covers this and nothing here is
# needed. Anywhere else, point these at any S3-compatible bucket (R2 via its S3
# endpoint, AWS S3, MinIO, Backblaze B2).
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── Machine-to-machine API ────────────────────────────────────────────────────
# Bearer key for the bulk import endpoints under /api/crm/*. A workspace-scoped
# key configured in the admin panel takes precedence; this is the global fallback.
# Generate with: node -e "console.log('ak_' + require('crypto').randomBytes(32).toString('hex'))"
IMPORT_API_KEY=""

# ── Cron ──────────────────────────────────────────────────────────────────────
# ⚠️ NOT optional: verifyCronRequest fails closed, so an unset secret means every
# scheduled job answers 500 forever — and a job that does not run leaves no log.
# That silently disables queued email, SLA breach detection, webhook retries,
# reminders and ticket auto-close.
# Generate with: openssl rand -hex 32
# On Vercel it also belongs in the project env vars (Vercel sends the header itself).
# On Cloudflare Workers: npx wrangler secret put CRON_SECRET
CRON_SECRET=""

# ── Multi-tenancy ─────────────────────────────────────────────────────────────
# Root domain used to detect tenant subdomains (e.g. "myapp.com" → tenant.myapp.com)
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"

# TESTING ONLY — enables /dev/switch-tenant/[slug] cookie escape hatch so you
# can access tenant CRM on Vercel preview URLs (which don't support wildcard subdomains).
# Set to "true" in Preview environments only. Never enable in Production.
ENABLE_TENANT_OVERRIDE="false"

# ── First platform administrator ──────────────────────────────────────────────
# Read by the seed script to create the first /admin account. Not used at runtime.
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""

# ── Stripe Billing ─────────────────────────────────────────────────────────────
# Create an account at https://stripe.com — test keys are fine for development.
STRIPE_SECRET_KEY="sk_test_…"
STRIPE_PUBLISHABLE_KEY="pk_test_…"
# Generate with: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_…"

# ── Web push notifications (optional) ─────────────────────────────────────────
# Without these the product works exactly as before: notifications appear in the
# bell inside Flux, and nothing reaches a device that is not looking at it.
#
# Generate a pair with:  npm run generate:vapid
# On Cloudflare set them as Worker secrets, never here:
#   npx wrangler secret put PUSH_VAPID_PRIVATE_KEY
#
# ⚠️ Rotating these silently invalidates every existing subscription: a browser
# subscribed against the old public key keeps an endpoint the new key cannot
# write to, and every send comes back 403. Everyone has to turn notifications on
# again, so rotate only when the private key has actually leaked.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
# How a push service reaches whoever operates this deployment. mailto: or https:.
# Defaults to the application's own address when unset.
PUSH_VAPID_SUBJECT=

# ── AI copilot (optional, Fase 5) ─────────────────────────────────────────────
# Without a key the copilot is simply not offered; nothing else changes.
# Which provider and model answer each task is configuration (src/lib/ai/config.ts):
#   AI_PROVIDER / AI_MODEL          every task: gemini (default, gemini-2.5-flash-lite) or
#                                   openai (gpt-5-mini). Unset, the provider whose key is set.
#   AI_MODEL_<TASK>                 one task on another model, e.g. AI_MODEL_CLASSIFY
#   AI_PROVIDER_<TASK>              one task on another provider (with its own AI_MODEL_<TASK>)
# ⚠️ Google keeps the 2.5 models to keys that already used them: a new key gets 404, reported
# as "model". Set AI_MODEL to a model the key can use (e.g. gemini-3.5-flash-lite).
# ⚠️ Use a paid (billing-enabled) Gemini key: customer data goes in the prompts.
# On Cloudflare set the key as a Worker secret, never here:
#   npx wrangler secret put GEMINI_API_KEY   (or OPENAI_API_KEY)
# OpenAI: the Responses API, nothing stored on OpenAI's side (store: false). A GPT-5 or o-series
# model thinks before answering; its effort is "low" unless OPENAI_REASONING_EFFORT says otherwise.
AI_PROVIDER=
AI_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_REASONING_EFFORT=
