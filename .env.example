# ── Database ──────────────────────────────────────────────────────────────────
# Neon PostgreSQL (https://neon.tech) or any PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ── Authentication ────────────────────────────────────────────────────────────
AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Sign up at https://resend.com — free tier: 100 emails/day
# Leave empty to use console logging in development
RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"
EMAIL_FROM="CRM <noreply@yourdomain.com>"

# ── App ────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Multi-tenancy ─────────────────────────────────────────────────────────────
# Root domain used to detect tenant subdomains (e.g. "myapp.com" → tenant.myapp.com)
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"

# TESTING ONLY — enables /dev/switch-tenant/[slug] cookie escape hatch so you
# can access tenant CRM on Vercel preview URLs (which don't support wildcard subdomains).
# Set to "true" in Preview environments only. Never enable in Production.
ENABLE_TENANT_OVERRIDE="false"
